<Project Sdk="WixToolset.Sdk/6.0.2">
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
		<DefineConstants>
			ExcelAddinFiles=..\Excel\bin\$(Configuration)\;
			PowerPointAddinFiles=..\PowerPoint\bin\$(Configuration)\;
			WordAddinFiles=..\Word\bin\$(Configuration)\
		</DefineConstants>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="WixToolset.Netfx.wixext" Version="6.0.2" />
		<PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
		<PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
	</ItemGroup>
</Project>